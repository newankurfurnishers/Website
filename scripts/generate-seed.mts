// Generates supabase/seed.sql from src/content/seed.ts
// Run: npm run seed:generate
import { writeFileSync } from "node:fs";
import { categories, elements, sections, sectors, settings, testimonials } from "../src/content/seed.ts";

const q = (v: unknown): string => {
  if (v === null || v === undefined) return "null";
  if (typeof v === "number" || typeof v === "boolean") return String(v);
  return `'${String(v).replace(/'/g, "''")}'`;
};
const arr = (xs: string[]) => `array[${xs.map(q).join(",")}]::text[]`;
const json = (v: unknown) => `${q(JSON.stringify(v ?? []))}::jsonb`;

const out: string[] = ["-- Generated by scripts/generate-seed.ts. Do not edit by hand.", "begin;", ""];

out.push(
  `insert into public.site_settings (id, business_name, tagline, established_year, phones, whatsapp, email, address, map_embed_url, instagram_url, facebook_url, seo_title, seo_description)
values (1, ${q(settings.business_name)}, ${q(settings.tagline)}, ${settings.established_year}, ${arr(settings.phones)}, ${q(settings.whatsapp)}, ${q(settings.email)}, ${q(settings.address)}, ${q(settings.map_embed_url)}, ${q(settings.instagram_url)}, ${q(settings.facebook_url)}, ${q(settings.seo_title)}, ${q(settings.seo_description)})
on conflict (id) do nothing;`,
  "",
);

for (const e of elements) {
  out.push(
    `insert into public.elements (slug, name, sanskrit, tagline, description, image_url, image_alt, sort) values (${[e.slug, e.name, e.sanskrit, e.tagline, e.description, e.image_url, e.image_alt].map(q).join(", ")}, ${e.sort}) on conflict (slug) do nothing;`,
  );
}
out.push("");

for (const s of sectors) {
  out.push(
    `insert into public.sectors (slug, name, tagline, summary, body, highlights, image_url, image_alt, sort) values (${[s.slug, s.name, s.tagline, s.summary, s.body].map(q).join(", ")}, ${json(s.highlights)}, ${q(s.image_url)}, ${q(s.image_alt)}, ${s.sort}) on conflict (slug) do nothing;`,
  );
}
out.push("");

for (const c of categories) {
  out.push(
    `insert into public.categories (slug, name, tagline, icon, intro, subtypes, hero_image_url, hero_image_alt, element_id, sort)
select ${[c.slug, c.name, c.tagline, c.icon, c.intro].map(q).join(", ")}, ${arr(c.subtypes)}, ${q(c.hero_image_url)}, ${q(c.hero_image_alt)}, (select id from public.elements where slug = ${q(c.element)}), ${c.sort}
on conflict (slug) do nothing;`,
  );
  c.images.forEach((im, i) =>
    out.push(
      `insert into public.category_images (category_id, url, alt, sort) select id, ${q(im.url)}, ${q(im.alt)}, ${i} from public.categories where slug = ${q(c.slug)} and not exists (select 1 from public.category_images ci join public.categories cc on cc.id = ci.category_id where cc.slug = ${q(c.slug)} and ci.url = ${q(im.url)});`,
    ),
  );
  for (const s of c.sectors) {
    out.push(
      `insert into public.category_sectors (category_id, sector_id) select c.id, s.id from public.categories c, public.sectors s where c.slug = ${q(c.slug)} and s.slug = ${q(s)} on conflict do nothing;`,
    );
  }
  out.push("");
}

for (const p of sections) {
  out.push(
    `insert into public.page_sections (page, key, label, eyebrow, heading, body, image_url, image_alt, cta_label, cta_href, items, sort) values (${[p.page, p.key, p.label, p.eyebrow, p.heading, p.body, p.image_url, p.image_alt, p.cta_label, p.cta_href].map(q).join(", ")}, ${json(p.items)}, ${p.sort}) on conflict (page, key) do nothing;`,
  );
}

out.push("");
for (const t of testimonials) {
  out.push(
    `insert into public.testimonials (name, context, quote, sort) values (${[t.name, t.context, t.quote].map(q).join(", ")}, ${t.sort}) on conflict do nothing;`,
  );
}

out.push("", "commit;", "");
writeFileSync(new URL("../supabase/seed.sql", import.meta.url), out.join("\n"));
console.log("Wrote supabase/seed.sql");

// ---------------------------------------------------------------------------
// content-update.sql: push edited launch copy to an ALREADY-seeded database.
// seed.sql only inserts (on conflict do nothing), so run this to refresh text.
// ---------------------------------------------------------------------------
const upd: string[] = [
  "-- Refresh launch copy on an already-seeded database. Safe to re-run.",
  "-- Run in Supabase → SQL Editor after editing src/content/seed.ts.",
  "begin;",
  "",
  `update public.site_settings set seo_title = ${q(settings.seo_title)}, seo_description = ${q(settings.seo_description)}, tagline = ${q(settings.tagline)} where id = 1;`,
  "",
];
for (const s of sectors) {
  upd.push(
    `update public.sectors set name = ${q(s.name)}, tagline = ${q(s.tagline)}, summary = ${q(s.summary)}, highlights = ${json(s.highlights)} where slug = ${q(s.slug)};`,
  );
}
upd.push("");
for (const cat of categories) {
  upd.push(
    `update public.categories set name = ${q(cat.name)}, tagline = ${q(cat.tagline)}, intro = ${q(cat.intro)}, subtypes = ${arr(cat.subtypes)} where slug = ${q(cat.slug)};`,
  );
}
upd.push("");
for (const p of sections) {
  upd.push(
    `update public.page_sections set eyebrow = ${q(p.eyebrow)}, heading = ${q(p.heading)}, body = ${q(p.body)}, cta_label = ${q(p.cta_label)}, items = ${json(p.items)} where page = ${q(p.page)} and key = ${q(p.key)};`,
  );
}
upd.push("", "commit;", "");
writeFileSync(new URL("../supabase/content-update.sql", import.meta.url), upd.join("\n"));
console.log("Wrote supabase/content-update.sql");
